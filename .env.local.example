# Copie ce fichier en .env.local pour le développement local (npm run dev).
# En production (Vercel), ne mets JAMAIS ces valeurs dans le code ni dans un
# fichier commité : renseigne-les dans Vercel > Project Settings > Environment
# Variables. Ce fichier .env.local.example ne contient aucun vrai secret.

# --- Supabase --- Project Settings > API (dans ton projet Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clé secrète — jamais exposée au navigateur, réservée aux routes serveur (envoi
# d'email, rattachement de compte). Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Compte Gmail dédié au club (envoi automatique des rapports / avis) ---
GMAIL_USER=club.hea.invest@gmail.com
# Mot de passe d'application à 16 caractères (PAS le mot de passe du compte Gmail) —
# voir le README pour la marche à suivre.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Envoi automatique mensuel des rapports individuels (Vercel Cron) ---
# Une chaîne aléatoire inventée par toi (pas besoin d'un format précis, juste longue
# et imprévisible — ex: un mot de passe généré au hasard). Sert uniquement à vérifier
# que l'appel vers /api/cron/monthly-reports vient bien de Vercel Cron et de personne
# d'autre. Vercel l'envoie automatiquement en en-tête Authorization sur les appels
# cron dès que cette variable existe sur le projet.
CRON_SECRET=une-longue-chaine-aleatoire-a-toi-de-choisir
